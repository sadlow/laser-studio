# Mapbox Public Access Token (pk.*) – derselbe wie in
# extendscript-bulk-processing/shared/config-local.jsx
MAPBOX_ACCESS_TOKEN=pk.

# Eigenes Kartenarchiv (OpenStreetMap als PMTiles, Protomaps) – dieselbe Datei wie im Baseline Customizer
# (karte/basiskarte-welt-20260923.pmtiles im Studio-Bucket). Lokal genuegt der oeffentliche Tagesbau; fehlt die
# Variable oder ist das Archiv nicht erreichbar, rechnet das Studio mit Mapbox.
KARTE_ARCHIV=https://build.protomaps.com/20260923.pmtiles
